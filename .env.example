# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Authentication Credentials (use reset-credentials.js to generate)
REACT_APP_ADMIN_USERNAME_HASH=your_username_hash_here
REACT_APP_ADMIN_PASSWORD_HASH=your_password_hash_here

# AWS Configuration
REACT_APP_AWS_ACCESS_KEY_ID=your_aws_access_key_here
REACT_APP_AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
REACT_APP_AWS_REGION=eu-central-1
REACT_APP_S3_BUCKET_NAME=your_bucket_name_here

# Security Settings
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_ALLOWED_FILE_TYPES=jpg,jpeg,png,webp
REACT_APP_AWS_MAX_RETRIES=3
REACT_APP_AWS_TIMEOUT=30000
REACT_APP_SECURITY_MONITORING=true
REACT_APP_MAX_UPLOADS_PER_MINUTE=10
REACT_APP_MAX_FILE_SIZE_MB=10
